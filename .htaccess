# Eagles Tourism — Apache / LiteSpeed (Hostinger)
Options -Indexes
DirectoryIndex index.php index.html

# Protect sensitive files: config, docs, install keys, logs, databases, dumps and backup copies
<FilesMatch "^(config\.php.*|config\.sample\.php|README\.md|DEPLOYMENT\.md|\.gitignore|\.user\.ini|\.env.*)$">
    Require all denied
</FilesMatch>
<FilesMatch "\.(sqlite|sqlite3|db|sql|key|log|lock|bak|backup|old|orig|save|swp|tmp|dist|zip|tar|gz|tgz|7z|rar)$|~$">
    Require all denied
</FilesMatch>
# Never serve version-control folders
<IfModule mod_alias.c>
    RedirectMatch 404 /\.(git|svn|hg)(/|$)
</IfModule>

# Force HTTPS (Hostinger provides a free SSL certificate)
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Same protection via rewrite rules (also honoured by LiteSpeed, which may ignore FilesMatch/Require)
    RewriteRule ^(includes|data)(/|$) - [F,L]
    RewriteRule ^uploads/.*\.(php\d?|phtml|phar|pht)$ - [F,L,NC]
    RewriteRule (^|/)(config\.php.*|config\.sample\.php|README\.md|DEPLOYMENT\.md|\.gitignore|\.user\.ini|\.env.*)$ - [F,L,NC]
    RewriteRule \.(sqlite|sqlite3|db|sql|key|log|lock|bak|backup|old|orig|save|swp|tmp|dist|zip|tar|gz|tgz|7z|rar)$ - [F,L,NC]

    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Security headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

# Browser caching for static files
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>
